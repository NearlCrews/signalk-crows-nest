{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["react", "react-dom", "node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  // The base config excludes src/panel (the Node build must not compile it),
  // and exclude does not merge across extends: without this override the
  // inherited exclude would empty the include below and this config would
  // type-check zero panel files.
  "exclude": ["node_modules", "dist"],
  "include": [
    "src/panel/**/*",
    "src/shared/types.ts",
    "src/status/status-types.ts",
    "src/shared/poi-type-selection.ts",
    "src/shared/plugin-id.ts"
  ]
}
