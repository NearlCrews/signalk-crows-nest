{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/panel/index.tsx",
    "scripts/*.mjs",
    "fixtures/browser/main.tsx",
    "fixtures/browser/vite.config.ts",
    "test/*.test.ts",
    "tests/browser/*.spec.ts",
  ],
  "project": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.mjs",
    "fixtures/**/*.ts",
    "fixtures/**/*.tsx",
    "test/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    "*.js",
    "*.cjs",
  ],
  "ignoreDependencies": [
    "@microsoft/eslint-formatter-sarif",
    // @signalk/server-api's public PluginRouter extends Express types without
    // declaring their package, so consumers that use the contract need this.
    "@types/express",
    "eslint-formatter-",
  ],
  "includeEntryExports": true,
  "ignoreIssues": {
    "fixtures/browser/vite.config.ts": ["exports"],
    "src/panel/PluginConfigurationPanel.tsx": ["exports"],
    "src/panel/index.tsx": ["exports"],
    "src/shared/rating.ts": ["duplicates"],
  },
  "treatConfigHintsAsErrors": true,
}
