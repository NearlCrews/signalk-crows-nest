{
  "name": "signalk-crows-nest",
  "version": "0.15.3",
  "description": "Imports points of interest from Garmin ActiveCaptain, OpenSeaMap, the USCG Light List, USCG Local Notices to Mariners, NOAA ENC Direct, NOAA CO-OPS, the NGA World Port Index, and USACE as Signal K notes resources, with proximity, route-corridor, and bridge air-draft alarms.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public",
    "assets",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "npm run build:plugin && npm run build:panel && npm run build:icons",
    "build:plugin": "tsc",
    "build:panel": "webpack --config webpack.config.cjs",
    "build:icons": "node scripts/copy-icons.mjs",
    "watch:panel": "webpack --watch --mode development --config webpack.config.cjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.panel.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "npm run lint:code && npm run lint:docs && npm run spellcheck",
    "lint:code": "eslint .",
    "lint:docs": "markdownlint-cli2 \"*.md\" \".github/*.md\" \"docs/*.md\" \"docs/decisions/*.md\" \"docs/maintainers/*.md\"",
    "spellcheck": "cspell --no-progress --show-suggestions README.md CHANGELOG.md THIRD_PARTY_NOTICES.md CLAUDE.md \".github/**/*.{md,yml,yaml}\" \"docs/*.md\" \"docs/decisions/*.md\" \"docs/maintainers/*.md\"",
    "lint:fix": "eslint . --fix",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --import tsx --test test/*.test.ts",
    "test:browser": "npm run build && playwright test --project=chromium",
    "test:browser:cross": "npm run build && playwright test",
    "format": "eslint . --fix && prettier --write \"*.{json,jsonc,md,yml,yaml}\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.{json,jsonc,md,yml,yaml}\"",
    "format:check": "prettier --check \"*.{json,jsonc,md,yml,yaml}\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.{json,jsonc,md,yml,yaml}\"",
    "deadcode": "knip --include files,dependencies,unlisted,binaries",
    "ci:workflows": "node scripts/check-workflows.mjs",
    "size": "size-limit",
    "package:check": "publint --pack npm --strict && node scripts/check-package.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=high",
    "verify:commit": "npm run lint && npm run format:check && npm run ci:workflows && npm run deadcode",
    "verify:fast": "npm run verify:commit && npm run typecheck",
    "verify": "npm run verify:fast && npm run test:coverage && npm run build && npm run size && npm run package:check && npm run audit:runtime",
    "verify:browser": "npm run verify && npm run test:browser",
    "verify:release": "npm run verify && playwright test && npm run audit:full",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator",
    "signalk-category-chart-plotters",
    "signalk-category-notifications",
    "points-of-interest",
    "notes",
    "chart-overlay",
    "activecaptain",
    "openseamap",
    "uscg",
    "noaa",
    "freeboard",
    "proximity-alarm",
    "route-corridor",
    "marina",
    "anchorage",
    "hazard",
    "tides",
    "currents",
    "ports",
    "locks"
  ],
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "Crow's Nest",
    "appIcon": "assets/icons/icon-192.png",
    "screenshots": [
      "assets/screenshots/freeboard-activecaptain-hazard.png",
      "assets/screenshots/freeboard-uscg-light-list.png",
      "assets/screenshots/admin-panel.png"
    ],
    "recommends": [
      "@signalk/freeboard-sk",
      "signalk-binnacle"
    ]
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "packageManager": "npm@11.18.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.3",
      "onFail": "warn"
    }
  },
  "author": {
    "name": "Nearl Crews",
    "email": "NearlCrews@users.noreply.github.com"
  },
  "contributors": [
    "Paul Willems (original author of signalk-activecaptain-resources)"
  ],
  "license": "MIT",
  "homepage": "https://github.com/NearlCrews/signalk-crows-nest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NearlCrews/signalk-crows-nest.git"
  },
  "bugs": {
    "url": "https://github.com/NearlCrews/signalk-crows-nest/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/nearlcrews"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "lru-cache": "^11.5.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "@playwright/test": "^1.62.1",
    "@signalk/server-api": "^2.30.0",
    "@size-limit/file": "13.0.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-loader": "^10.1.1",
    "c8": "12.0.0",
    "cspell": "10.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "knip": "6.31.0",
    "markdownlint-cli2": "0.23.2",
    "neostandard": "^0.13.0",
    "prettier": "3.9.6",
    "publint": "0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "signalk-nearlcrews-ui": "0.6.1",
    "size-limit": "13.0.3",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "size-limit": [
    {
      "name": "Configuration panel JavaScript",
      "path": "public/*.js",
      "limit": "50 kB",
      "gzip": true
    }
  ],
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
